# Copy to .env and fill in your values.
# The database PASSWORD is NOT stored here — enter it in the Settings UI
# after launching the app. It will be saved to config/local.json (gitignored).

# SQL Server / Azure SQL — server and database name only (no password)
DB_SERVER=yourserver.database.windows.net
DB_NAME=ArxParts
DB_USER=yourusername

# Web server port (default 4568)
PORT=4568

# Secret key for session cookies — change this to a long random string
SESSION_SECRET=change-me-to-something-long-and-random

# Set to "true" to use test PO number sequence
TEST_MODE=false

# Optional: default paths for file serving (can also be set in the Settings UI)
# DOC_CONTROL_ROOT=C:\DocControl
# PO_FOLDER_ROOT=C:\PurchaseOrders
