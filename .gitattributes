# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Source / docs / data — LF in repo AND on disk (working tree).
*.go    text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.work  text eol=lf
*.sum   text eol=lf
*.mod   text eol=lf
.env*   text eol=lf

# Windows scripts — MUST be CRLF on disk.
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.cmd   text eol=crlf

# Legacy VBA sources (archive/) — keep as-is, CRLF on disk.
*.bas       text eol=crlf
*.cls       text eol=crlf
*.frm       text eol=crlf
*.doccls    text eol=crlf

# Binaries — never touch.
*.png   binary
*.ico   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.xlsm  binary
*.xls   binary
*.frx   binary
*.zip   binary
*.svg   text eol=lf
