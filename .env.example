# Shared .env for all Arx Go apps.
# Copy to .env and fill in your values.
# DB password is NOT stored here — enter it in each app's Settings UI on first run.

# SQL Server / Azure SQL
DB_SERVER=yourserver.database.windows.net
DB_NAME=YourDatabase
DB_USER=yourusername

# Set to "true" to connect to the test database (ArxDev) instead of production
TEST_MODE=false

# Session cookie secret — leave unset: a random per-user key is generated automatically.
# If you override it, use a long random string (32+ bytes); shorter values are ignored.
# SESSION_SECRET=

# File paths (can also be set per-app in the Settings UI)
# DOC_CONTROL_ROOT=C:\Path\To\DocControl
# IMAGE_ROOT=C:\Path\To\TestImages
# PO_FOLDER_ROOT=C:\Path\To\PurchaseOrders
# SUPPLIER_FILES_ROOT=C:\Path\To\SupplierDocs

# Port — built-in default, so this is optional
# PORT=4568
